# Railway ETA Prediction System - Environment Configuration
# Copy this file to .env and fill in your API keys

# ========================================
# RAPIDAPI KEY - Get from https://rapidapi.com
# Search "Indian Railway" or "IRCTC Train"
# Subscribe to any free Indian Railway API tier
# ========================================
RAPIDAPI_KEY=your_rapidapi_key_here

# ========================================
# RAPIDAPI HOST - Changes based on which API you subscribe to on RapidAPI
# Common options (subscribe to ONE on RapidAPI):
#   Option A: irctc1.p.rapidapi.com         (IRCTC API - 500 free/month)
#   Option B: india-rail.p.rapidapi.com     (India Rail API)
#   Option C: trains.p.rapidapi.com         (Trains API)
# ========================================
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# ========================================
# OPTIONAL: Redis (for caching live data)
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Database (optional, SQLite used by default)
# ========================================
DATABASE_URL=sqlite:///./railway_eta.db
